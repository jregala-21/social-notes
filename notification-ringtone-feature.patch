+  gap: 8px;
+  flex-wrap: wrap;
+}
+
+.notification-settings-actions button {
+  flex: 1 1 auto;
+}
+
+@media (max-width: 520px) {
+  .settings-select-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .notification-settings-actions {
